{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "Avorythm",
  "description": "__MSG_appDescription__",
  "version": "1.1.3",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "tabCapture", "offscreen", "storage", "scripting"],
  "optional_permissions": ["downloads"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "optional_host_permissions": ["https://api.groq.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "__MSG_actionTitle__"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "homepage_url": "https://github.com/msmahdinejad/avorythm",
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "web_accessible_resources": [{
    "resources": ["assets/vazirmatn-arabic.woff2", "assets/vazirmatn-latin.woff2"],
    "matches": ["<all_urls>"]
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
